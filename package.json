{
  "name": "cloud-penny-lambda",
  "version": "1.0.0",
  "description": "Cloud Penny Lambda functions and deployment tooling",
  "private": true,
  "scripts": {
    "zip": "node scripts/zip-functions.js",
    "create": "node scripts/create-function.js",
    "import:state": "node scripts/import-existing.js",
    "test": "vitest run",
    "test:watch": "vitest",
