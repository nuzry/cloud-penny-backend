    "eval:chat": "node evals/chat/run.mjs"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^4.1.11",
    "archiver": "^6.0.2",
    "aws-sdk-client-mock": "^4.1.0",
    "vitest": "^4.1.11"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "@aws-sdk/client-athena": "^3.1114.0",
    "@aws-sdk/client-cognito-identity-provider": "^3.1118.0",
    "@aws-sdk/client-dynamodb": "^3.1117.0",
    "@aws-sdk/client-glue": "^3.1118.0",
    "@aws-sdk/client-s3": "^3.1118.0",
    "@aws-sdk/client-secrets-manager": "^3.1118.0",
    "@aws-sdk/client-ses": "^3.1118.0",
    "@aws-sdk/lib-dynamodb": "^3.1117.0",
    "@aws-sdk/s3-request-presigner": "^3.1118.0"
  }
